{
  "name": "flecten",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "connector:x": "bun --env-file=connectors/x-chatgpt/.env src/connectors/x/server.ts",
    "app": "bun run build:ui && bun run build:agent && bun scripts/launch-electron.mjs",
    "app:dev": "bun scripts/dev-desktop.mjs",
    "app:shot": "bun run build:ui && bun run build:agent && bun scripts/launch-electron.mjs --shot",
    "dev:ui": "vite",
    "build:ui": "vite build",
    "build:agent": "bun scripts/build-agent.ts",
    "build:marketplace": "bun scripts/build-marketplace.ts",
    "test": "bun test tests/unit tests/integration tests/smoke.test.ts",
    "test:e2e": "bun run build:ui && bun run build:agent && bunx playwright test",
    "check": "tsc --noEmit && svelte-check --workspace ui",
    "lint": "biome check . && bun scripts/check-rules.mjs",
    "docs:check": "bun scripts/docs-check.mjs",
    "coverage": "bun scripts/coverage.mjs",
    "format": "biome format --write .",
    "verify": "bun run test && bun run check && bun run lint && bun scripts/docs-check.mjs && bun run build:ui && bun run build:agent",
    "package": "bun run build:ui && bun run build:agent && electron-builder --dir",
    "release": "bun run build:ui && bun run build:agent && electron-builder",
    "smoke:packaged": "bun scripts/smoke-packaged.mjs",
    "sbom": "bun scripts/sbom.mjs",
    "checksums": "bun scripts/release-checksums.mjs",
    "rules": "bun scripts/check-rules.mjs",
    "logos:sync": "bun scripts/sync-provider-logos.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@electron/notarize": "^3.0.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.4.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/svelte": "^1.1.5",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.11",
    "marked": "^18.1.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mermaid": "^12.2.0",
    "micromark-extension-gfm": "^3.0.0",
    "morphicons": "^2.0.2",
    "parse5": "^8.1.1",
    "zod": "^4.6.7"
  },
  "description": "Харнесс для агентной работы: контекст, проверки и доказательства.",
  "license": "MIT",
  "author": "Flecten contributors",
  "main": "shell/main.mjs",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=20"
  }
}
