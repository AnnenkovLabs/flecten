{
  "name": "flecten",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "scripts": {
    "connector:x": "bun --env-file=connectors/x-chatgpt/.env src/connectors/x/server.ts",
    "app": "bun run build:ui && bun run build:agent && bun scripts/launch-electron.mjs",
    "app:dev": "bun scripts/dev-desktop.mjs",
    "app:shot": "bun run build:ui && bun run build:agent && bun scripts/launch-electron.mjs --shot",
    "dev:ui": "vite",
    "build:ui": "vite build",
    "build:agent": "bun scripts/build-agent.ts",
    "test": "bun test --timeout 20000 tests/unit tests/integration tests/smoke.test.ts",
    "test:e2e": "bun run build:ui && bun run build:agent && bunx playwright test",
    "check": "node node_modules/@typescript/native/bin/tsc --noEmit && svelte-check --workspace ui --tsgo",
    "lint": "biome check . && bun scripts/check-rules.mjs",
    "docs:check": "bun scripts/docs-check.mjs",
    "coverage": "bun scripts/coverage.mjs",
    "format": "biome format --write .",
    "verify": "bun run test && bun run check && bun run lint && bun scripts/docs-check.mjs && bun run build:ui && bun run build:agent",
    "package": "bun run build:ui && bun run build:agent && bun scripts/package-installers.mjs --dir",
    "release:publish": "bun scripts/publish-release.mjs",
    "release": "bun run build:ui && bun run build:agent && bun scripts/package-installers.mjs",
    "smoke:packaged": "bun scripts/smoke-packaged.mjs",
    "sbom": "bun scripts/sbom.mjs",
    "checksums": "bun scripts/release-checksums.mjs",
    "rules": "bun scripts/check-rules.mjs",
    "logos:sync": "bun scripts/sync-provider-logos.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.4.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/svelte": "^1.1.5",
    "@lezer/javascript": "^1.5.6",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@tiptap/core": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.18",
    "electron-updater": "^6.8.12",
    "marked": "^18.2.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mermaid": "^12.3.0",
    "micromark-extension-gfm": "^3.0.0",
    "monaco-editor": "^0.57.0",
    "morphicons": "^2.0.2",
    "parse5": "^8.1.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "app-builder-lib>@electron/notarize": "3.1.2",
    "app-builder-lib>minimatch": "11.0.9",
    "@electron/universal>minimatch": "11.0.9"
  },
  "description": "Desktop workspace for coding agents: context, verification, and evidence.",
  "license": "AGPL-3.0-only",
  "author": "Flecten contributors",
  "main": "shell/main.mjs",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22.12.0"
  }
}
