OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

FLECTEN_PROVIDER=openai
FLECTEN_MODEL=gpt-5.1

# Optional: project root for the sidecar.
# FLECTEN_CWD=/path/to/project
# Optional: path to flecten.config.json.
# FLECTEN_CONFIG=/path/to/flecten.config.json
LUMINAL_API_KEY=

# Optional: PostHog anonymous telemetry (EU Cloud default; DO_NOT_TRACK=1 or FLECTEN_TELEMETRY=0 disables).
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://eu.i.posthog.com
# FLECTEN_TELEMETRY=0
