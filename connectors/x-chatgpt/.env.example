# Public HTTPS origin, without /mcp or a trailing path.
X_CONNECTOR_URL=https://x-connector.example.com

# X Developer Console > your app > OAuth 2.0 Client ID and Client Secret.
# App type: Web App. Callback URL: https://x-connector.example.com/auth/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# These are the connector's credentials for ChatGPT, separate from the X app.
X_CONNECTOR_CLIENT_ID=chatgpt-x
X_CONNECTOR_CLIENT_SECRET=

# Generate a separate 32-byte base64url secret. Keep it stable across restarts.
X_CONNECTOR_ENCRYPTION_KEY=

# Use the exact redirect URI displayed by ChatGPT for this connection.
X_CONNECTOR_REDIRECT_URI=https://chatgpt.com/connector_platform_oauth_redirect

# Reverse proxy preserves the public Host header. Bind locally by default.
X_CONNECTOR_HOST=127.0.0.1
X_CONNECTOR_PORT=8787
X_CONNECTOR_STORE=.liquid/x-connector/oauth.enc
