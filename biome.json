{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "src/**",
      "shared/**",
      "tests/**",
      "ui/src/**/*.ts",
      "scripts/**",
      "vite.config.ts",
      "ui/svelte.config.js",
      "!!.kilo",
      "!!.deploy",
      "!!src/marketplace"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
