{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "src/**",
      "shared/**",
      "tests/**",
      "ui/src/**/*.ts",
      "scripts/**",
      "vite.config.ts",
      "ui/svelte.config.js",
      "!!.kilo",
      "!!.deploy",
      "!!src/marketplace",
      "!!tests/fixtures/modules"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "usePlaywrightValidDescribeCallback": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["tests/e2e/**"],
      "linter": {
        "rules": {
          "correctness": {
            "usePlaywrightValidDescribeCallback": "error"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
